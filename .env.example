# Copy to .env and adjust if needed. All defaults assume a local Ollama instance.

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=llama3.1:8b
OLLAMA_EMBED_MODEL=nomic-embed-text

# Confidence threshold below which the agent retries (up to AGENT_MAX_RETRIES) then escalates
AGENT_CONFIDENCE_THRESHOLD=0.65
AGENT_MAX_RETRIES=2

DATA_DIR=data

# Optional: LangSmith tracing of the LangGraph agent workflow
# (retrieve -> compare -> confidence_check -> retry/escalate). Get a key at
# https://smith.langchain.com -- leave LANGSMITH_TRACING=false to disable.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=skillmapper
